#!/usr/bin/env python3
"""Offline stand-in for the codexbar CLI, for UI smoke runs and the devkit.

Point the extension at it with CODEXBAR_BIN=<this file>. It never reads
accounts, credentials or the network. STUB_CODEXBAR_SYNC=0 makes it behave
like upstream's CLI: no `codexbar sync` and no /sync/* routes in `serve`.
STUB_CODEXBAR_REPORT=1 adds a capability report to /health.
"""

import json
import os
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

SYNC = os.environ.get("STUB_CODEXBAR_SYNC", "1") != "0"
REPORT = os.environ.get("STUB_CODEXBAR_REPORT") == "1"
VERSION = "0.69.0"


def unknown_command(name):
    if "--json-only" in sys.argv:
        print(json.dumps([{"provider": "cli", "source": "cli", "error": {
            "code": 1, "kind": "args", "message": f"Unknown command '{name}'"}}]))
    else:
        print(f"Unknown command '{name}'", file=sys.stderr)
    sys.exit(1)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_args):
        pass

    def send_json(self, status, body):
        data = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urlsplit(self.path).path
        if path == "/health":
            body = {"status": "ok", "version": VERSION}
            if REPORT:
                body["capabilities"] = ["machineSync"] if SYNC else []
                body["usagebarVersion"] = VERSION
                body["upstreamVersion"] = VERSION
            self.send_json(200, body)
        elif path in ("/usage", "/cost"):
            self.send_json(200, [])
        elif path == "/sync/status" and SYNC:
            self.send_json(200, {"paired": False})
        else:
            self.send_json(404, {"error": "not found"})

    def do_POST(self):
        if urlsplit(self.path).path == "/sync/push" and SYNC:
            self.send_json(200, {"status": "pushed", "uploaded": []})
        else:
            self.send_json(405, {"error": "method not allowed"})


def serve(argv):
    port = int(argv[argv.index("--port") + 1])
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()


def main():
    argv = sys.argv[1:]
    if "--version" in argv or "-V" in argv:
        print(f"CodexBar {VERSION}")
        return
    command = argv[0] if argv else ""
    if command == "serve":
        serve(argv)
    elif command == "config":
        if argv[1:2] == ["providers"]:
            print("[]")
    elif command == "sync" and SYNC:
        if argv[1:2] == ["settings"]:
            print(json.dumps({"paired": False, "machineId": None, "displayName": "stub",
                              "server": None, "reportingDay": {
                                  "timeZone": None, "startHour": 0, "effectiveTimeZone": "UTC"}}))
        else:
            print(json.dumps([{"provider": "cli", "source": "cli", "error": {
                "code": 1, "kind": "runtime", "message": "stub: not supported",
                "reason": "network"}}]))
            sys.exit(1)
    else:
        unknown_command(command)


if __name__ == "__main__":
    main()
