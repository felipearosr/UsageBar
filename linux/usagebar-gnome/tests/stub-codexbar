def spend(cost):
    return {"costUSD": cost, "costIncomplete": False, "totalTokens": 0, "requests": 0}


def machine(machine_id, this, cost, provider):
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    today = time.strftime("%Y-%m-%d")
    return {"machineId": machine_id, "displayName": machine_id, "isThisMachine": this,
            "active": True, "retired": False, "lastSeen": now,
            "today": spend(cost / 3), "last30Days": spend(cost),
            "models": [{"provider": provider, "model": f"{machine_id}-model", "spend": spend(cost)}],
            "days": [{"date": today, "spend": spend(cost / 3)}],
            "coverage": {"from": today, "to": today}}


def sync_status():
    if not PAIRED:
        return {"paired": False}
    return {"paired": True,
            "refreshedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "status": {"today": time.strftime("%Y-%m-%d"),
                       "total": {"today": spend(10 / 3), "last30Days": spend(10)},
                       "errors": [],
                       "machines": [machine("stub-laptop", True, 6, "claude"),
                                    machine("stub-desk", False, 4, "codex")]}}


