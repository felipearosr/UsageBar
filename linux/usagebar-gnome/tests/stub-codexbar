    ["providerAccountKinds", "providerAccountAddKey", "providerAccountRename", "providerAccountRemove"]
    if ACTION_TOKEN else []) + (["providerAccountAddClaudeSwap"] if ACTION_TOKEN and CLAUDE_SWAP_ADD else []) + (
    ["providerAccountSwitch"] if ACTION_TOKEN and CLAUDE_SWITCH else [])
DETECTS = {"count": 0}
CODEX_ACCOUNT_CAPABILITIES = ["providerAccountRows"] + (
    ["providerAccountKinds", "providerAccountAddCliLogin"] if ACTION_TOKEN else [])
# The OpenRouter token accounts, in store order. Only ids, labels and which
# one is active: the stub never keeps a key.
OPENROUTER = [
    {"id": "6f0c2a9e-1b4d-4c8a-9e2f-0a1b2c3d4e5f", "label": "Personal", "failing": True},
    {"id": "0d9e8f7a-6b5c-4d3e-8f1a-2b3c4d5e6f70", "label": "Work", "failing": False, "percent": 64},
]
if SPARE:
    OPENROUTER.append({"id": "9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d", "label": "Spare", "failing": False,
                       "percent": 12})
ACTIVE = {"id": "0d9e8f7a-6b5c-4d3e-8f1a-2b3c4d5e6f70"}
# claude-swap's active slot (STUB_CODEXBAR_CLAUDE_SWITCH), and whether the
# next /usage comes after a switch (it then takes SWITCH_DELAY too).
CLAUDE = {"active": 2, "slow_usage": False}
LOCK = threading.Lock()


def account_rows(all_accounts):
    def window(percent, minutes, reset_secs):
        return {"usedPercent": percent, "windowMinutes": minutes, "resetsAt": iso(-reset_secs)}
    claude = {"provider": "claude", "source": "oauth",
              "usage": {"primary": window(22, 300, 7200), "secondary": window(41, 10080, 300000),
                        "updatedAt": iso(30)}}

    if CLAUDE_SWAP:
        claude = claude_swap_rows(all_accounts, window)
    else:
        claude = [claude]

    def row(account, percent):
        if account["failing"]:
            return {"provider": "openrouter", "source": "api", "account": account["label"],
                    "error": {"code": 1, "kind": "provider",
                              "message": "OpenRouter API error: 401 Unauthorized (invalid key)"}}
        return {"provider": "openrouter", "source": "api", "account": account["label"],
                "usage": {"primary": window(percent, 43200, 900000), "updatedAt": iso(240)}}

    with LOCK:
        accounts = list(OPENROUTER)
        active = ACTIVE["id"]
    if not accounts:
        return claude
    active_account = next((a for a in accounts if a["id"] == active), accounts[0])
    # Like serve: one account (or a client without accounts=all) gets the
    # active account's plain row.
    if not all_accounts or len(accounts) == 1:
        return claude + [row(active_account, active_account.get("percent", 64))]
    rows = list(claude)
    for index, account in enumerate(accounts):
        tagged = row(account, account.get("percent", 64 - 20 * index))
        tagged.update({"accountId": f"token:{account['id']}", "accountSource": "token",
                       "accountLabel": account["label"], "active": account["id"] == active})
        if "usage" in tagged:
            tagged["updatedAt"] = tagged["usage"]["updatedAt"]
        rows.append(tagged)
    return rows


def account_action(path, body):
    """(status, payload) for one /accounts/* POST against the in-memory store."""
    if not isinstance(body, dict) or body.get("provider") != "openrouter":
        return 400, {"error": "Unknown provider."}
    with LOCK:
        if path == "/accounts/add":
            if not str(body.get("token") or "").strip():
                return 400, {"error": "A key is required."}
            label = str(body.get("label") or "").strip() or f"Account {len(OPENROUTER) + 1}"
            account = {"id": str(uuid.uuid4()), "label": label, "failing": False}
            OPENROUTER.append(account)
            ACTIVE["id"] = account["id"]
            return 200, {"provider": "openrouter", "accountId": f"token:{account['id']}",
                         "accountLabel": label, "active": True}
        account_id = str(body.get("accountId") or "")
        match = next((a for a in OPENROUTER if f"token:{a['id']}" == account_id), None)
        if match is None:
            return 404, {"error": "No such account."}
        if path == "/accounts/rename":
            label = str(body.get("label") or "").strip()
            if not label:
                return 400, {"error": "A label is required."}
            match["label"] = label
            return 200, {"provider": "openrouter", "accountId": account_id, "accountLabel": label,
                         "active": ACTIVE["id"] == match["id"]}
        index = OPENROUTER.index(match)
        OPENROUTER.remove(match)
        if ACTIVE["id"] == match["id"] and OPENROUTER:
            ACTIVE["id"] = OPENROUTER[min(index, len(OPENROUTER) - 1)]["id"]
        return 200, {"provider": "openrouter", "accountId": account_id, "removed": True}


def claude_swap_rows(all_accounts, window):
    # Synthetic slots only: example.com labels, no tokens.
    active = {"provider": "claude", "source": "claude-swap",
              "usage": {"primary": window(31, 300, 9000), "secondary": window(47, 10080, 400000),
                        "updatedAt": iso(120), "loginMethod": "Claude Max",
                        "identity": {"providerID": "claude", "accountEmail": "work@example.com",
                                     "accountOrganization": "Example Org", "loginMethod": "Claude Max",
                                     "accountID": "claude-swap:2"}}}
    if CLAUDE_SWITCH:
        return claude_switch_rows(all_accounts, window)
    if not all_accounts:
        return [active]
    active.update({"account": "work@example.com", "accountId": "claude-swap:2",
                   "accountSource": "claude-swap", "accountLabel": "work@example.com", "active": True,
                   "updatedAt": iso(120)})
    stale = {"provider": "claude", "source": "claude-swap-stale", "account": "personal@example.com",
             "accountId": "claude-swap:1", "accountSource": "claude-swap",
             "accountLabel": "personal@example.com", "active": False, "stale": True,
             "updatedAt": iso(5400),
             "usage": {"primary": window(88, 300, 3600), "secondary": window(62, 10080, 300000),
                       "updatedAt": iso(5400)},
             "error": {"code": 1, "kind": "provider",
                       "message": "Token expired. Switch to this account in claude-swap to refresh it."}}
    rows = [active, stale]
    if claude_added():
        rows.append({"provider": "claude", "source": "claude-swap", "account": "added@example.com",
                     "accountId": "claude-swap:3", "accountSource": "claude-swap",
                     "accountLabel": "added@example.com", "active": False, "updatedAt": iso(60),
                     "usage": {"primary": window(5, 300, 9000), "secondary": window(9, 10080, 400000),
                               "updatedAt": iso(60)}})
    return rows


def claude_added_flag():
    data = os.environ.get("XDG_DATA_HOME") or ""
    return os.path.join(data, "usagebar-stub-claude-added") if data.startswith("/") else None


def claude_added():
    flag = claude_added_flag()
    return bool(flag) and os.path.exists(flag)


def claude_switch_rows(all_accounts, window):
    # Slot 1's token expired, so it never offers Switch; 2 and 3 do while inactive.
    with LOCK:
        active_slot = CLAUDE["active"]
    slots = [(1, "personal@example.com", 88, False), (2, "work@example.com", 31, True),
             (3, "spare@example.com", 9, True)]
    rows = []
    for slot, email, percent, healthy in slots:
        row = {"provider": "claude", "source": "claude-swap" if healthy else "claude-swap-stale",
               "account": email,
               "usage": {"primary": window(percent, 300, 9000), "secondary": window(percent // 2, 10080, 400000),
                         "updatedAt": iso(120 if healthy else 5400)}}
        if not healthy:
            row["error"] = {"code": 1, "kind": "provider",
                            "message": "Token expired. Switch to this account in claude-swap to refresh it."}
        if not all_accounts:
            if slot == active_slot:
                row.pop("account")
                return [row]
            continue
        row.update({"accountId": f"claude-swap:{slot}", "accountSource": "claude-swap", "accountLabel": email,
                    "active": slot == active_slot, "updatedAt": row["usage"]["updatedAt"]})
        if not healthy:
            row["stale"] = True
        if healthy and slot != active_slot:
            row["canSwitch"] = True
        rows.append(row)
    # Like serve: the active slot first, then by slot.
    return sorted(rows, key=lambda row: not row["active"])


def claude_switch(body):
    """(status, payload) for POST /accounts/switch against the in-memory slots."""
    if not isinstance(body, dict) or body.get("provider") != "claude":
        return 400, {"error": "Only Claude accounts can be switched here."}
    account_id = str(body.get("accountId") or "")
    target = next((row for row in claude_switch_rows(True, lambda *_: {}) if row["accountId"] == account_id), None)
    if target is None:
        return 404, {"error": "No such account."}
    if not target.get("canSwitch"):
        return 409, {"error": "This account can't be switched to."}
    time.sleep(SWITCH_DELAY)
    with LOCK:
        CLAUDE["slow_usage"] = True
        if account_id == "claude-swap:2":
            return 502, {"error": "Account switch failed: claude-swap reported account slot 3 after "
                                  "CodexBar requested slot 2."}
        CLAUDE["active"] = int(account_id.split(":")[1])
    return 200, {"provider": "claude", "accountId": account_id, "switched": True,
                 "activeAccountId": account_id, "refreshError": None}


def codex_account_rows(all_accounts):
    def window(percent, minutes, reset_secs):
        return {"usedPercent": percent, "windowMinutes": minutes, "resetsAt": iso(-reset_secs)}

    def row(email, source, account_id, active, usage=None, error=None):
        body = {"provider": "codex", "source": "oauth", "account": email}
        if usage:
            body["usage"] = usage
        if error:
            body["error"] = {"code": 1, "kind": "provider", "message": error}
        if all_accounts:
            body.update({"accountId": f"{source}:{account_id}", "accountSource": source,
                         "accountLabel": email, "active": active})
            if usage:
                body["updatedAt"] = usage["updatedAt"]
        return body
    added = [row(account["email"], "codex-managed", account["id"], False,
                 usage={"primary": window(5, 300, 18000), "secondary": window(9, 10080, 600000),
                        "updatedAt": iso(10)})
             for account in stub_codex_store()["accounts"]]
    return [
        row("me@example.com", "codex-system", "3f9a1c2b7d4e8f60", True,
            usage={"primary": window(18, 300, 9000), "secondary": window(52, 10080, 400000),
                   "updatedAt": iso(20)}),
        row("old@example.com", "codex-managed", "7a1e2d3c-4b5a-4c6d-8e7f-9a0b1c2d3e4f", False,
            error="Codex OAuth token expired. Run `codex login` in this account's home."),
        row("work@example.com", "codex-managed", "1b2c3d4e-5f60-4718-9a2b-3c4d5e6f7a8b", False,
            usage={"primary": window(71, 300, 3600), "secondary": window(33, 10080, 500000),
                   "updatedAt": iso(90)}),
    ] + added


def stub_data_dir():
    """$XDG_DATA_HOME/CodexBar, or None when XDG_DATA_HOME is unset or is the real one."""
    data_home = os.environ.get("XDG_DATA_HOME") or ""
    real = os.path.join(os.path.expanduser("~"), ".local", "share")
    if not data_home.startswith("/") or os.path.realpath(data_home) == os.path.realpath(real):
        return None
    return os.path.join(data_home, "CodexBar")


def stub_codex_store():
    directory = stub_data_dir()
    if not directory:
        return {"accounts": []}
    try:
        with open(os.path.join(directory, "managed-codex-accounts.json")) as handle:
            store = json.load(handle)
        return store if isinstance(store.get("accounts"), list) else {"accounts": []}
    except (OSError, ValueError, AttributeError):
        return {"accounts": []}


def codex_accounts_add():
    """The add helper's steps against a fake codex; prints done or the failing step."""
    def fail(step, home=None):
        if home:
            shutil.rmtree(home, ignore_errors=True)
        print(f"\nFailed: {step}", file=sys.stderr)
        sys.exit(1)

    directory = stub_data_dir()
    if not directory:
        fail("the stub needs an XDG_DATA_HOME of its own.")
    codex = os.environ.get("STUB_CODEX_BIN") or ""
    if not codex.startswith("/") or not os.access(codex, os.X_OK):
        fail("couldn't find the codex CLI (the stub only runs STUB_CODEX_BIN).")
    print("Adding a Codex account. Codex opens its sign-in page in your browser.")
    print("Your everyday Codex login is not changed.\n")
    home = os.path.join(directory, "managed-codex-homes", str(uuid.uuid4()))
    os.makedirs(home, mode=0o700)
    env = dict(os.environ, CODEX_HOME=home)
    sys.stdout.flush()
    status = subprocess.run([codex, "login"], env=env, check=False).returncode
    if status != 0:
        fail(f"`codex login` exited with status {status}. No account was added.", home)
    try:
        with open(os.path.join(home, "auth.json")) as handle:
            email = str(json.load(handle).get("email") or "").strip()
    except (OSError, ValueError, AttributeError):
        fail("`codex login` finished, but its login couldn't be read. No account was added.", home)
    if not email:
        fail("`codex login` finished, but the login has no email. No account was added.", home)
    store = stub_codex_store()
    store["accounts"].append({"id": str(uuid.uuid4()), "email": email, "home": home})
    with open(os.path.join(directory, "managed-codex-accounts.json"), "w") as handle:
        json.dump(store, handle)
    print(f"\nDone. Added {email} to UsageBar.")


def unknown_command(name):
    if "--json-only" in sys.argv:
        print(json.dumps([{"provider": "cli", "source": "cli", "error": {
            "code": 1, "kind": "args", "message": f"Unknown command '{name}'"}}]))
    else:
        print(f"Unknown command '{name}'", file=sys.stderr)
    sys.exit(1)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_args):
        pass

    def send_json(self, status, body):
        data = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        parts = urlsplit(self.path)
        path = parts.path
        if path == "/health" and time.monotonic() - STARTED < HEALTH_FAIL_SECS:
            self.send_json(503, {"error": "starting"})
        elif path == "/health":
            body = {"status": "ok", "version": VERSION}
            if REPORT or ACCOUNTS or CODEX_ACCOUNTS:
                body["capabilities"] = (["machineSync"] if SYNC else []) + \
                    (ACCOUNT_CAPABILITIES + [c for c in CODEX_ACCOUNT_CAPABILITIES
                                             if c not in ACCOUNT_CAPABILITIES] if SHOWCASE else
                     ACCOUNT_CAPABILITIES if ACCOUNTS else
                     CODEX_ACCOUNT_CAPABILITIES if CODEX_ACCOUNTS else [])
                body["usagebarVersion"] = VERSION
                body["upstreamVersion"] = VERSION
            self.send_json(200, body)
        elif path == "/usage" and SHOWCASE:
            all_accounts = "accounts=all" in parts.query.split("&")
            with LOCK:
                slow, CLAUDE["slow_usage"] = CLAUDE["slow_usage"], False
            if slow:
                time.sleep(SWITCH_DELAY)
            covered = {"claude", "codex", "openrouter"}
            self.send_json(200, account_rows(all_accounts) + codex_account_rows(all_accounts) +
                           [row for row in issue_rows() if row["provider"] not in covered])
        elif path == "/usage" and ISSUES:
            self.send_json(200, issue_rows())
        elif path == "/accounts/kinds" and CODEX_ACCOUNTS and not ACCOUNTS:
            self.send_json(200, {"providers": {
                "codex": {"kind": "cli-login", "rename": False, "remove": False, "replacesCurrent": False}}})
        elif path == "/accounts/kinds" and ACCOUNTS:
            self.send_json(200, {"providers": {
                "openrouter": {"kind": "key", "placeholder": "sk-or-…", "rename": True, "remove": True,
                               "replacesCurrent": False},
                "claude": dict({"rename": True, "remove": True, "replacesCurrent": False},
                               **({"kind": "claude-swap"} if CLAUDE_SWAP_ADD else {})),
                **({"codex": {"kind": "cli-login", "rename": False, "remove": False,
                              "replacesCurrent": False}} if SHOWCASE else {})}})
        elif path == "/usage" and CODEX_ACCOUNTS:
            self.send_json(200, codex_account_rows("accounts=all" in parts.query.split("&")))
        elif path == "/usage" and ACCOUNTS:
            with LOCK:
                slow, CLAUDE["slow_usage"] = CLAUDE["slow_usage"], False
            if slow:
                time.sleep(SWITCH_DELAY)
            self.send_json(200, account_rows("accounts=all" in parts.query.split("&")))
        elif path in ("/usage", "/cost"):
            self.send_json(200, [])
        elif path == "/sync/status" and SYNC:
            self.send_json(200, sync_status())
        else:
            self.send_json(404, {"error": "not found"})

    def do_POST(self):
        path = urlsplit(self.path).path
        if path == "/sync/push" and SYNC:
            self.send_json(200, {"status": "pushed", "uploaded": []})
        elif path == "/accounts/claude-swap/detect" and CLAUDE_SWAP_ADD:
            presented = (self.headers.get("X-UsageBar-Action-Token") or "").encode()
            if not ACTION_TOKEN or not hmac.compare_digest(presented, ACTION_TOKEN.encode()):
                self.send_json(403, {"error": "missing or wrong action token"})
                return
            with LOCK:
                DETECTS["count"] += 1
                installed = DETECTS["count"] > 1
            if installed:
                self.send_json(200, {"installed": True, "executablePath": "/stub/home/.local/bin/cswap",
                                     "enabled": True})
            else:
                self.send_json(200, {"installed": False, "enabled": False,
                                     "message": "claude-swap is not installed."})
        elif path in ("/accounts/add", "/accounts/rename", "/accounts/remove") and ACCOUNTS or \
                path == "/accounts/switch" and CLAUDE_SWITCH:
            length = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(length) or b"null")
            except ValueError:
                body = None
            presented = (self.headers.get("X-UsageBar-Action-Token") or "").encode()
            if not ACTION_TOKEN or not hmac.compare_digest(presented, ACTION_TOKEN.encode()):
                self.send_json(403, {"error": "missing or wrong action token"})
                return
            if self.headers.get("Origin"):
                self.send_json(403, {"error": "forbidden origin"})
                return
            if (self.headers.get("Content-Type") or "").split(";")[0].strip() != "application/json":
                self.send_json(400, {"error": "Expected a JSON body."})
                return
            if path == "/accounts/switch":
                self.send_json(*claude_switch(body))
                return
            self.send_json(*account_action(path, body))
        else:
            self.send_json(405, {"error": "method not allowed"})


def exit_with_parent():
    # GNOME Shell going away (end of a smoke run) must not leave serve behind.
    parent = os.getppid()
    while os.getppid() == parent:
        time.sleep(1)
    os._exit(0)


def serve(argv):
    port = int(argv[argv.index("--port") + 1])
    threading.Thread(target=exit_with_parent, daemon=True).start()
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()


