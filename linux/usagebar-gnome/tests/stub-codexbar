#!/usr/bin/env python3
"""Offline stand-in for the codexbar CLI, for UI smoke runs and the devkit.

Point the extension at it with CODEXBAR_BIN=<this file>. It never reads
accounts, credentials or the network. STUB_CODEXBAR_SYNC=0 makes it behave
like upstream's CLI: no `codexbar sync` and no /sync/* routes in `serve`.
STUB_CODEXBAR_REPORT=1 adds a capability report to /health.
STUB_CODEXBAR_PAIRED=1 (with sync) pretends this Machine is in a Sync Group
with one other Machine, so the Machines tab and the paired Settings page show.
STUB_CODEXBAR_ISSUES=1 makes /usage return one healthy provider and one of
each provider error state, for the issues banner and Details dialog.
STUB_CODEXBAR_ACCOUNTS=1 advertises providerAccountRows on /health and answers
/usage?accounts=all with two OpenRouter Provider Accounts (Work active, the
Personal key failing) next to a single-account Claude row; plain /usage gets
the single-account rows an older CLI would send. It also advertises the
account actions: /accounts/kinds offers `key` for OpenRouter, and
/accounts/add, /accounts/rename and /accounts/remove change the OpenRouter
accounts in memory (keys are checked for presence and never stored).
STUB_CODEXBAR_HEALTH_FAIL_SECS=N answers /health with 503 for the first N
seconds after serve starts, like a serve that isn't ready yet.
"""

import json
import os
import sys
import threading
import time
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

SYNC = os.environ.get("STUB_CODEXBAR_SYNC", "1") != "0"
REPORT = os.environ.get("STUB_CODEXBAR_REPORT") == "1"
PAIRED = SYNC and os.environ.get("STUB_CODEXBAR_PAIRED") == "1"
ISSUES = os.environ.get("STUB_CODEXBAR_ISSUES") == "1"
ACCOUNTS = os.environ.get("STUB_CODEXBAR_ACCOUNTS") == "1"
HEALTH_FAIL_SECS = float(os.environ.get("STUB_CODEXBAR_HEALTH_FAIL_SECS") or 0)
STARTED = time.monotonic()
VERSION = "0.69.0"
REPORTING_DAY = {"timeZone": None, "startHour": 0, "effectiveTimeZone": "UTC"}


def spend(cost):
    return {"costUSD": cost, "costIncomplete": False, "totalTokens": 0, "requests": 0}


def machine(machine_id, this, cost, provider):
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    today = time.strftime("%Y-%m-%d")
    return {"machineId": machine_id, "displayName": machine_id, "isThisMachine": this,
            "active": True, "retired": False, "lastSeen": now,
            "today": spend(cost / 3), "last30Days": spend(cost),
            "models": [{"provider": provider, "model": f"{machine_id}-model", "spend": spend(cost)}],
            "days": [{"date": today, "spend": spend(cost / 3)}],
            "coverage": {"from": today, "to": today}}


def sync_status():
    if not PAIRED:
        return {"paired": False}
    return {"paired": True,
            "refreshedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "status": {"today": time.strftime("%Y-%m-%d"),
                       "total": {"today": spend(10 / 3), "last30Days": spend(10)},
                       "errors": [],
                       "machines": [machine("stub-laptop", True, 6, "claude"),
                                    machine("stub-desk", False, 4, "codex")]}}


def issue_rows():
    def failing(provider, message, code=1, kind="provider"):
        return {"provider": provider, "source": "stub",
                "error": {"code": code, "kind": kind, "message": message}}
    window = {"usedPercent": 40, "windowMinutes": 300}
    return [
        failing("codex", "Codex connection failed: failed to fetch codex rate limits: "
                '{"error": {"message": "Provided authentication token is expired. Please try '
                'signing in again.", "type": "invalid_request_error", "code": "token_expired"}, '
                '"status": 401}'),
        failing("gemini", "Gemini credentials not found. Not logged in."),
        failing("claude", "Claude OAuth usage endpoint is rate limited by Anthropic."),
        failing("copilot", "Request timed out", code=4, kind="runtime"),
        failing("cursor", "HTTP 503 Service Unavailable"),
        failing("openrouter", "Could not parse OpenRouter usage: unexpected key 'limits'"),
        {"provider": "opencodego", "source": "stub",
         "usage": {"primary": window, "updatedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}},
    ]


def iso(offset_secs=0):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - offset_secs))


ACCOUNT_CAPABILITIES = ["providerAccountRows", "providerAccountKinds", "providerAccountAddKey",
                        "providerAccountRename", "providerAccountRemove"]
# The OpenRouter token accounts, in store order. Only ids, labels and which
# one is active: the stub never keeps a key.
OPENROUTER = [
    {"id": "6f0c2a9e-1b4d-4c8a-9e2f-0a1b2c3d4e5f", "label": "Personal", "failing": True},
    {"id": "0d9e8f7a-6b5c-4d3e-8f1a-2b3c4d5e6f70", "label": "Work", "failing": False},
]
ACTIVE = {"id": "0d9e8f7a-6b5c-4d3e-8f1a-2b3c4d5e6f70"}
LOCK = threading.Lock()


def account_rows(all_accounts):
    def window(percent, minutes, reset_secs):
        return {"usedPercent": percent, "windowMinutes": minutes, "resetsAt": iso(-reset_secs)}
    claude = {"provider": "claude", "source": "oauth",
              "usage": {"primary": window(22, 300, 7200), "secondary": window(41, 10080, 300000),
                        "updatedAt": iso(30)}}

    def row(account, percent):
        if account["failing"]:
            return {"provider": "openrouter", "source": "api", "account": account["label"],
                    "error": {"code": 1, "kind": "provider",
                              "message": "OpenRouter API error: 401 Unauthorized (invalid key)"}}
        return {"provider": "openrouter", "source": "api", "account": account["label"],
                "usage": {"primary": window(percent, 43200, 900000), "updatedAt": iso(240)}}

    with LOCK:
        accounts = list(OPENROUTER)
        active = ACTIVE["id"]
    if not accounts:
        return [claude]
    active_account = next((a for a in accounts if a["id"] == active), accounts[0])
    # Like serve: one account (or a client without accounts=all) gets the
    # active account's plain row.
    if not all_accounts or len(accounts) == 1:
        return [claude, row(active_account, 64)]
    rows = [claude]
    for index, account in enumerate(accounts):
        tagged = row(account, 64 - 20 * index)
        tagged.update({"accountId": f"token:{account['id']}", "accountSource": "token",
                       "accountLabel": account["label"], "active": account["id"] == active})
        if "usage" in tagged:
            tagged["updatedAt"] = tagged["usage"]["updatedAt"]
        rows.append(tagged)
    return rows


def account_action(path, body):
    """(status, payload) for one /accounts/* POST against the in-memory store."""
    if not isinstance(body, dict) or body.get("provider") != "openrouter":
        return 400, {"error": "Unknown provider."}
    with LOCK:
        if path == "/accounts/add":
            if not str(body.get("token") or "").strip():
                return 400, {"error": "A key is required."}
            label = str(body.get("label") or "").strip() or f"Account {len(OPENROUTER) + 1}"
            account = {"id": str(uuid.uuid4()), "label": label, "failing": False}
            OPENROUTER.append(account)
            ACTIVE["id"] = account["id"]
            return 200, {"provider": "openrouter", "accountId": f"token:{account['id']}",
                         "accountLabel": label, "active": True}
        account_id = str(body.get("accountId") or "")
        match = next((a for a in OPENROUTER if f"token:{a['id']}" == account_id), None)
        if match is None:
            return 404, {"error": "No such account."}
        if path == "/accounts/rename":
            label = str(body.get("label") or "").strip()
            if not label:
                return 400, {"error": "A label is required."}
            match["label"] = label
            return 200, {"provider": "openrouter", "accountId": account_id, "accountLabel": label,
                         "active": ACTIVE["id"] == match["id"]}
        index = OPENROUTER.index(match)
        OPENROUTER.remove(match)
        if ACTIVE["id"] == match["id"] and OPENROUTER:
            ACTIVE["id"] = OPENROUTER[min(index, len(OPENROUTER) - 1)]["id"]
        return 200, {"provider": "openrouter", "accountId": account_id, "removed": True}


def unknown_command(name):
    if "--json-only" in sys.argv:
        print(json.dumps([{"provider": "cli", "source": "cli", "error": {
            "code": 1, "kind": "args", "message": f"Unknown command '{name}'"}}]))
    else:
        print(f"Unknown command '{name}'", file=sys.stderr)
    sys.exit(1)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_args):
        pass

    def send_json(self, status, body):
        data = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        parts = urlsplit(self.path)
        path = parts.path
        if path == "/health" and time.monotonic() - STARTED < HEALTH_FAIL_SECS:
            self.send_json(503, {"error": "starting"})
        elif path == "/health":
            body = {"status": "ok", "version": VERSION}
            if REPORT or ACCOUNTS:
                body["capabilities"] = (["machineSync"] if SYNC else []) + \
                    (ACCOUNT_CAPABILITIES if ACCOUNTS else [])
                body["usagebarVersion"] = VERSION
                body["upstreamVersion"] = VERSION
            self.send_json(200, body)
        elif path == "/usage" and ISSUES:
            self.send_json(200, issue_rows())
        elif path == "/accounts/kinds" and ACCOUNTS:
            self.send_json(200, {"providers": {"openrouter": {"kind": "key", "placeholder": "sk-or-…"}}})
        elif path == "/usage" and ACCOUNTS:
            self.send_json(200, account_rows("accounts=all" in parts.query.split("&")))
        elif path in ("/usage", "/cost"):
            self.send_json(200, [])
        elif path == "/sync/status" and SYNC:
            self.send_json(200, sync_status())
        else:
            self.send_json(404, {"error": "not found"})

    def do_POST(self):
        path = urlsplit(self.path).path
        if path == "/sync/push" and SYNC:
            self.send_json(200, {"status": "pushed", "uploaded": []})
        elif path in ("/accounts/add", "/accounts/rename", "/accounts/remove") and ACCOUNTS:
            length = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(length) or b"null")
            except ValueError:
                body = None
            if self.headers.get("Origin") or \
                    (self.headers.get("Content-Type") or "").split(";")[0].strip() != "application/json":
                self.send_json(400, {"error": "Expected a JSON body."})
                return
            self.send_json(*account_action(path, body))
        else:
            self.send_json(405, {"error": "method not allowed"})


def exit_with_parent():
    # GNOME Shell going away (end of a smoke run) must not leave serve behind.
    parent = os.getppid()
    while os.getppid() == parent:
        time.sleep(1)
    os._exit(0)


def serve(argv):
    port = int(argv[argv.index("--port") + 1])
    threading.Thread(target=exit_with_parent, daemon=True).start()
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()


def main():
    argv = sys.argv[1:]
    if "--version" in argv or "-V" in argv:
        print(f"CodexBar {VERSION}")
        return
    command = argv[0] if argv else ""
    if command == "serve":
        serve(argv)
    elif command == "config":
        if argv[1:2] == ["providers"]:
            print("[]")
    elif command == "sync" and SYNC:
        if argv[1:2] == ["settings"]:
            print(json.dumps({"paired": PAIRED, "machineId": "stub-laptop" if PAIRED else None,
                              "displayName": "stub-laptop",
                              "server": "https://sync.example.invalid" if PAIRED else None,
                              "reportingDay": REPORTING_DAY}))
        elif argv[1:2] == ["status"] and PAIRED:
            print(json.dumps(sync_status()["status"]))
        else:
            print(json.dumps([{"provider": "cli", "source": "cli", "error": {
                "code": 1, "kind": "runtime", "message": "stub: not supported",
                "reason": "network"}}]))
            sys.exit(1)
    else:
        unknown_command(command)


if __name__ == "__main__":
    main()
